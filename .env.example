# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role   # secreta: nunca use no navegador

# ---- Endereço público do sistema ----
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# ---- Evolution API (servidor do WhatsApp) ----
EVOLUTION_API_URL=https://evolution.seu-dominio.com.br
EVOLUTION_API_KEY=a-mesma-AUTHENTICATION_API_KEY-da-evolution
# instância usada para enviar os códigos de login por WhatsApp (conectada no painel admin)
EVOLUTION_SYSTEM_INSTANCE=rr-sistema

# ---- Segredos ----
# Supabase > Authentication > Hooks > Send SMS hook (formato v1,whsec_...)
SEND_SMS_HOOK_SECRET=v1,whsec_...
# qualquer texto longo e aleatório; a Vercel envia no cron de cobrança
CRON_SECRET=troque-por-um-texto-aleatorio-longo
